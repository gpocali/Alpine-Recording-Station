#!/sbin/openrc-run
# =============================================================================
# OpenRC Init Script for Alpine Recording Station Kiosk (VT7 Post-Boot Service)
# =============================================================================
# Runs after system boot services complete and launches the X11 kiosk on VT7,
# keeping tty1-tty6 completely independent for console login and recovery.
# =============================================================================

name="Alpine Recording Station"
description="Fullscreen USB Audio Recording Kiosk on VT7"

command="/usr/local/bin/alpine-recorder"
command_args="daemon"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"

depend() {
    need localmount
    after bootmisc modules udev eudev alsa samba local networking
}

start_pre() {
    mkdir -p /var/log /storage /storage/.alpine-recorder
    chmod 0777 /storage 2>/dev/null || true
}

stop_post() {
    pkill -f "python3 -m app.main" 2>/dev/null || true
    pkill -f "xinit /root/.xinitrc" 2>/dev/null || true
    pkill -x Xorg 2>/dev/null || true
    if ! pgrep -x Xorg >/dev/null 2>&1; then
        rm -f /tmp/.X0-lock /tmp/.X11-unix/X0 2>/dev/null || true
    fi
}
