[global]
   workgroup = WORKGROUP
   server string = Alpine Recording Station
   security = user
   map to guest = Never
   passdb backend = tdbsam
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   log file = /var/log/samba/log.%m
   max log size = 50
   dns proxy = no
   smb2 leases = no
   kernel oplocks = no
   stat cache = no
   change notify = yes
   kernel change notify = yes

[storage]
   comment = Alpine Recording Station WAV Storage
   path = /storage
   browseable = yes
   writable = yes
   read only = no
   guest ok = no
   valid users = @sambashare
   admin users = @sambashare
   force user = root
   force group = sambashare
   inherit owner = windows and unix
   inherit permissions = no
   create mask = 0777
   force create mode = 0666
   directory mask = 2777
   force directory mode = 2777
   nt acl support = no
   map readonly = no
   store dos attributes = no
   dos filemode = yes
   oplocks = no
   level2 oplocks = no
   strict locking = no
   strict sync = yes
   sync always = yes
   use mmap = no
   veto files = /.alpine-recorder/lost+found/
   delete veto files = no
