#!/bin/sh
# =============================================================================
# Alpine Recording Station - CLI Launcher, Service Supervisor & Diagnostics
# =============================================================================
# Usage:
#   alpine-recorder [run] [--vt N] [-- app_args...]   Launch kiosk in foreground
#   alpine-recorder start|stop|restart|status         Control OpenRC service
#   alpine-recorder enable|disable                    Enable/disable boot service
#   alpine-recorder logs                              View Xorg & recorder logs
#   alpine-recorder doctor                            Run hardware/X11 diagnostics
#   alpine-recorder recover                           Restore tty1 & stop Xorg
# =============================================================================

set -u

APP_DIR="/opt/alpine-recorder"
XINITRC="/root/.xinitrc"
LOG_DIR="/var/log"
APP_LOG="${LOG_DIR}/alpine-recorder.log"
XORG_LOG="${LOG_DIR}/alpine-recorder-xorg.log"
PIDFILE="/run/alpine-recorder.pid"
DEFAULT_VT="${ALPINE_RECORDER_VT:-7}"
APK_CACHE_DIR="/storage/.alpine-recorder/apk-cache"

mkdir -p "${LOG_DIR}" 2>/dev/null || true

log_info() {
    printf "\033[1;34m[INFO]\033[0m %s\n" "$1"
}

log_ok() {
    printf "\033[1;32m[OK]\033[0m   %s\n" "$1"
}

log_warn() {
    printf "\033[1;33m[WARN]\033[0m %s\n" "$1"
}

log_err() {
    printf "\033[1;31m[FAIL]\033[0m %s\n" "$1" >&2
}

cleanup_stale_x_locks() {
    if ! pgrep -x Xorg >/dev/null 2>&1 && ! pgrep -x X >/dev/null 2>&1; then
        rm -f /tmp/.X0-lock /tmp/.X11-unix/X0 2>/dev/null || true
    fi
}

check_runtime_packages_ok() {
    for bin in Xorg xinit startx openbox xset; do
        if ! command -v "$bin" >/dev/null 2>&1; then
            return 1
        fi
    done
    if ! command -v python3 >/dev/null 2>&1; then
        return 1
    fi
    if ! PYTHONPATH="${APP_DIR}" QT_QPA_PLATFORM=offscreen python3 -c "import PyQt6.QtWidgets, numpy, app.main" >/dev/null 2>&1; then
        return 1
    fi
    return 0
}

ensure_runtime_packages() {
    if check_runtime_packages_ok; then
        return 0
    fi
    if ! command -v apk >/dev/null 2>&1; then
        return 1
    fi

    msg="Missing X11/PyQt6 packages after boot (diskless RAM root). Restoring packages..."
    log_info "$msg"
    printf "%s [INFO] %s\n" "$(date -Iseconds 2>/dev/null || date)" "$msg" >>"${APP_LOG}"

    mkdir -p /storage 2>/dev/null || true
    if ! mountpoint -q /storage 2>/dev/null; then
        mount /storage 2>/dev/null || mount -a 2>/dev/null || true
    fi
    mkdir -p "${APK_CACHE_DIR}" /etc/apk 2>/dev/null || true
    if [ ! -e /etc/apk/cache ] && [ ! -L /etc/apk/cache ] && [ -d "${APK_CACHE_DIR}" ]; then
        ln -snf "${APK_CACHE_DIR}" /etc/apk/cache 2>/dev/null || true
    fi

    # 1. Try fast offline restore from persistent /storage/.alpine-recorder/apk-cache or /etc/apk/cache
    if ls "${APK_CACHE_DIR}"/*.apk >/dev/null 2>&1; then
        apk add --no-network "${APK_CACHE_DIR}"/*.apk >>"${APP_LOG}" 2>&1 || \
            apk fix --no-network >>"${APP_LOG}" 2>&1 || true
    elif ls /etc/apk/cache/*.apk >/dev/null 2>&1; then
        apk add --no-network /etc/apk/cache/*.apk >>"${APP_LOG}" 2>&1 || \
            apk fix --no-network >>"${APP_LOG}" 2>&1 || true
    fi

    # 2. If still missing packages, install over network and populate persistent cache
    if ! check_runtime_packages_ok; then
        if [ -f /etc/apk/repositories ] && ! grep -Eq '^[^#].*/community' /etc/apk/repositories; then
            sed -i -E 's|^#[[:space:]]*(https?://.*/v[0-9]+\.[0-9]+/community)|\1|g' /etc/apk/repositories 2>/dev/null || true
            sed -i -E 's|^#[[:space:]]*(https?://.*/edge/community)|\1|g' /etc/apk/repositories 2>/dev/null || true
        fi

        REQ_PKGS="
            python3 py3-qt6 py3-numpy alsa-lib alsa-utils alsa-ucm-conf
            samba samba-common-tools xorg-server xinit xauth xset openbox
            xf86-input-libinput xf86-input-evdev xf86-video-fbdev mesa-dri-gallium
            ttf-dejavu fontconfig libxkbcommon-x11 xcb-util-wm xcb-util-image
            xcb-util-keysyms xcb-util-renderutil xcb-util-cursor dbus kbd eudev
            util-linux iproute2 openssl ca-certificates
        "
        case "$(uname -m)" in
            x86_64|i*86) REQ_PKGS="${REQ_PKGS} xf86-video-vesa" ;;
        esac

        apk update >>"${APP_LOG}" 2>&1 || true
        apk fix >>"${APP_LOG}" 2>&1 || true
        # shellcheck disable=SC2086
        apk add $REQ_PKGS >>"${APP_LOG}" 2>&1 || true
        for opt_pkg in qt6-qtbase-x11 xsetroot font-cursor-misc libxcursor xcursor-themes adwaita-icon-theme; do
            apk add "$opt_pkg" >>"${APP_LOG}" 2>&1 || true
        done
        apk cache sync >>"${APP_LOG}" 2>&1 || apk cache download >>"${APP_LOG}" 2>&1 || true
        if [ -d /etc/apk/cache ] && [ "$(cd /etc/apk/cache 2>/dev/null && pwd -P)" != "$(cd "${APK_CACHE_DIR}" 2>/dev/null && pwd -P)" ]; then
            cp -f /etc/apk/cache/*.apk /etc/apk/cache/APKINDEX*.tar.gz "${APK_CACHE_DIR}/" 2>/dev/null || true
        fi
        if ! ls "${APK_CACHE_DIR}"/*.apk >/dev/null 2>&1; then
            # shellcheck disable=SC2086
            apk fetch --recursive -o "${APK_CACHE_DIR}" $REQ_PKGS xsetroot 2>/dev/null || true
        fi
    fi

    # Ensure Xwrapper and groups exist after package restore
    mkdir -p /etc/X11
    if [ ! -f /etc/X11/Xwrapper.config ]; then
        printf "allowed_users=anybody\nneeds_root_rights=yes\n" >/etc/X11/Xwrapper.config
    fi
    if command -v rc-service >/dev/null 2>&1; then
        rc-service alsa start >/dev/null 2>&1 || true
        rc-service samba start >/dev/null 2>&1 || true
    fi

    if check_runtime_packages_ok; then
        log_ok "Runtime X11 and PyQt6 packages verified/restored."
        return 0
    fi
    log_err "Unable to restore all required X11/PyQt6 packages. Check network or run ./install.sh."
    return 1
}

cleanup_legacy_boot_hooks() {
    cleaned=0
    if [ -f /etc/inittab ] && grep -Eq 'alpine-recorder-autologin|getty.*-a root' /etc/inittab; then
        sed -i 's|^tty1::respawn:.*|tty1::respawn:/sbin/getty 38400 tty1|g' /etc/inittab
        kill -HUP 1 2>/dev/null || true
        cleaned=1
    fi
    if [ -f /usr/local/bin/alpine-recorder-autologin ]; then
        rm -f /usr/local/bin/alpine-recorder-autologin
        cleaned=1
    fi
    if [ -f /root/.profile ] && grep -q "ALPINE_RECORDER_KIOSK_AUTOSTART" /root/.profile; then
        sed -i '/# ALPINE_RECORDER_KIOSK_AUTOSTART/,/^fi$/d' /root/.profile
        cleaned=1
    fi
    return $cleaned
}

print_recent_logs() {
    echo "-----------------------------------------------------------------------------"
    if [ -f "${APP_LOG}" ] && [ -s "${APP_LOG}" ]; then
        echo "=== Last 20 lines of ${APP_LOG} ==="
        tail -n 20 "${APP_LOG}"
        echo ""
    fi
    if [ -f "${XORG_LOG}" ] && [ -s "${XORG_LOG}" ]; then
        echo "=== Last 20 lines of ${XORG_LOG} ==="
        tail -n 20 "${XORG_LOG}"
        echo ""
    fi
    if [ -f /var/log/Xorg.0.log ]; then
        echo "=== Errors (EE) in /var/log/Xorg.0.log ==="
        grep "(EE)" /var/log/Xorg.0.log | tail -n 15 || true
    fi
    echo "-----------------------------------------------------------------------------"
}

run_doctor() {
    echo "============================================================================="
    echo " Alpine Recording Station - System & Hardware Diagnostics"
    echo "============================================================================="
    issues=0

    # 1. Check tty1 / inittab / .profile state
    if [ -f /etc/inittab ] && grep -Eq 'alpine-recorder-autologin|getty.*-a root' /etc/inittab; then
        log_err "/etc/inittab still has legacy tty1 autologin hook (run 'alpine-recorder recover')."
        issues=$((issues + 1))
    else
        log_ok "tty1 in /etc/inittab is configured as a normal login console."
    fi

    if [ -f /root/.profile ] && grep -q "ALPINE_RECORDER_KIOSK_AUTOSTART" /root/.profile; then
        log_err "/root/.profile still has legacy startx hook (run 'alpine-recorder recover')."
        issues=$((issues + 1))
    else
        log_ok "/root/.profile is clean (will not hijack root login shell)."
    fi

    # 2. Check display devices (/dev/dri/* or /dev/fb*)
    if ls /dev/dri/card* >/dev/null 2>&1 || ls /dev/fb* >/dev/null 2>&1; then
        devs="$(ls /dev/dri/card* /dev/fb* 2>/dev/null | tr '\n' ' ')"
        log_ok "Display hardware nodes detected: ${devs}"
    else
        log_warn "No /dev/dri/card* or /dev/fb* nodes found. Ensure KMS/framebuffer drivers are loaded."
        issues=$((issues + 1))
    fi

    # 3. Check X11 & Openbox binaries
    for bin in Xorg xinit startx openbox xset; do
        if command -v "$bin" >/dev/null 2>&1; then
            log_ok "Found required binary: $bin ($(command -v "$bin"))"
        else
            log_err "Missing required binary: $bin"
            issues=$((issues + 1))
        fi
    done

    # 4. Check Python & PyQt6 import
    if command -v python3 >/dev/null 2>&1; then
        if PYTHONPATH="${APP_DIR}" QT_QPA_PLATFORM=offscreen python3 -c "import PyQt6.QtWidgets, numpy, app.main" >/dev/null 2>&1; then
            log_ok "Python 3, PyQt6, NumPy, and app.main verified successfully."
        else
            log_err "Python/PyQt6 verification failed:"
            PYTHONPATH="${APP_DIR}" QT_QPA_PLATFORM=offscreen python3 -c "import PyQt6.QtWidgets, numpy, app.main" 2>&1 | sed 's/^/       /'
            issues=$((issues + 1))
        fi
    else
        log_err "python3 not found."
        issues=$((issues + 1))
    fi

    # 5. Check ALSA Audio Interfaces
    if [ -f /proc/asound/cards ]; then
        if grep -q "\[" /proc/asound/cards 2>/dev/null; then
            log_ok "ALSA soundcards detected:"
            sed 's/^/       /' /proc/asound/cards
        else
            log_warn "No ALSA soundcards currently connected in /proc/asound/cards."
        fi
    else
        log_warn "/proc/asound/cards not present (is snd-usb-audio loaded?)."
    fi

    # 6. Check /storage directory, mount status, and persistent APK cache
    mkdir -p /storage 2>/dev/null || true
    if ! mountpoint -q /storage 2>/dev/null; then
        mount /storage 2>/dev/null || mount -a 2>/dev/null || true
    fi
    if [ -d /storage ] && [ -w /storage ]; then
        if mountpoint -q /storage 2>/dev/null; then
            log_ok "/storage is mounted on a persistent drive and is writable."
        else
            log_warn "/storage exists and is writable, but is not a separate mountpoint (check /etc/fstab)."
        fi
    else
        log_err "/storage directory is missing or not writable."
        issues=$((issues + 1))
    fi

    if ls "${APK_CACHE_DIR}"/*.apk >/dev/null 2>&1 || ls /etc/apk/cache/*.apk >/dev/null 2>&1; then
        log_ok "Persistent APK package cache is populated for diskless reboots."
    else
        log_warn "No cached .apk packages found in ${APK_CACHE_DIR} or /etc/apk/cache (packages may not persist on diskless reboot)."
    fi

    echo "============================================================================="
    if [ "$issues" -eq 0 ]; then
        log_ok "Diagnostics passed with no critical issues."
        return 0
    else
        log_warn "Diagnostics found ${issues} potential issue(s)."
        log_info "Run 'alpine-recorder fix-packages' or re-run './install.sh' to install and cache missing packages."
        return 1
    fi
}

run_foreground() {
    vt="${DEFAULT_VT}"
    # If invoked directly from a physical tty (e.g. /dev/tty1..6), use that VT unless overridden
    current_tty="$(tty 2>/dev/null || true)"
    case "$current_tty" in
        /dev/tty[0-9]*)
            vt="${current_tty#/dev/tty}"
            ;;
    esac

    app_args=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --vt)
                shift
                vt="${1:-$DEFAULT_VT}"
                ;;
            --)
                shift
                app_args="$*"
                break
                ;;
            *)
                app_args="${app_args} $1"
                ;;
        esac
        shift
    done

    export PYTHONPATH="${APP_DIR}"
    export QT_AUTO_SCREEN_SCALE_FACTOR=1
    export ALPINE_RECORDER_ARGS="${app_args}"
    export ALPINE_RECORDER_SINGLE_RUN=1

    ensure_runtime_packages || true

    # If an X11 DISPLAY is already active, run the Python application directly
    if [ -n "${DISPLAY:-}" ]; then
        log_info "Active DISPLAY=${DISPLAY} detected; starting Alpine Recording Station UI..."
        # shellcheck disable=SC2086
        exec /usr/bin/python3 -m app.main $app_args
    fi

    # If background OpenRC service is already running Xorg, stop it first to avoid display :0 conflict
    if pgrep -x Xorg >/dev/null 2>&1; then
        log_warn "An Xorg server is already running. Use 'alpine-recorder restart' or 'alpine-recorder stop' first."
        return 1
    fi

    cleanup_stale_x_locks
    log_info "Starting Alpine Recording Station X11 session on vt${vt}..."
    log_info "Logs: ${APP_LOG} and ${XORG_LOG}"

    xinit "${XINITRC}" -- /usr/bin/Xorg :0 "vt${vt}" -keeptty >"${XORG_LOG}" 2>&1
    rc=$?

    if [ "$rc" -ne 0 ]; then
        log_err "X11 / Recorder session exited with status code ${rc}."
        print_recent_logs
        return "$rc"
    fi
    log_ok "Alpine Recording Station session exited cleanly."
    return 0
}

run_daemon() {
    # Wait briefly after OpenRC boot completion so getty on tty1..6 and udev settle
    sleep 2

    export PYTHONPATH="${APP_DIR}"
    export QT_AUTO_SCREEN_SCALE_FACTOR=1
    export ALPINE_RECORDER_SINGLE_RUN=0

    # Restore X11/PyQt6 packages from persistent cache (or network) if missing on diskless boot
    ensure_runtime_packages || true

    fast_fails=0
    max_fast_fails=3

    while true; do
        cleanup_stale_x_locks
        start_ts="$(date +%s)"
        printf "%s [INFO] Starting X11 kiosk session on vt%s...\n" "$(date -Iseconds 2>/dev/null || date)" "${DEFAULT_VT}" >>"${APP_LOG}"

        xinit "${XINITRC}" -- /usr/bin/Xorg :0 "vt${DEFAULT_VT}" -keeptty >"${XORG_LOG}" 2>&1
        rc=$?
        end_ts="$(date +%s)"
        elapsed=$((end_ts - start_ts))

        # Clean exit (code 0, e.g. user selected Exit to Console or service stopped)
        if [ "$rc" -eq 0 ]; then
            printf "%s [INFO] Kiosk session exited cleanly (code 0). Switching to tty1.\n" "$(date -Iseconds 2>/dev/null || date)" >>"${APP_LOG}"
            command -v chvt >/dev/null 2>&1 && chvt 1 2>/dev/null || true
            exit 0
        fi

        printf "%s [ERROR] Kiosk session exited with code %s after %ss.\n" "$(date -Iseconds 2>/dev/null || date)" "$rc" "$elapsed" >>"${APP_LOG}"

        if [ "$elapsed" -lt 10 ]; then
            fast_fails=$((fast_fails + 1))
        else
            fast_fails=0
        fi

        if [ "$fast_fails" -ge "$max_fast_fails" ]; then
            msg="Alpine Recording Station failed to start ${fast_fails} times in a row on vt${DEFAULT_VT}. Aborting respawn loop so console login remains unaffected."
            printf "%s [CRITICAL] %s\n" "$(date -Iseconds 2>/dev/null || date)" "$msg" >>"${APP_LOG}"
            command -v chvt >/dev/null 2>&1 && chvt 1 2>/dev/null || true
            if [ -w /dev/tty1 ]; then
                printf "\n\033[1;33m[ALPINE-RECORDER]\033[0m Kiosk UI on vt%s failed to start (tty1 login is unaffected).\n" "${DEFAULT_VT}" >/dev/tty1 2>/dev/null || true
                printf "  Run 'alpine-recorder logs' or 'alpine-recorder doctor' after logging in to troubleshoot.\n\n" >/dev/tty1 2>/dev/null || true
            fi
            exit 1
        fi

        sleep 3
    done
}

show_status() {
    echo "============================================================================="
    echo " Alpine Recording Station - Service & Process Status"
    echo "============================================================================="
    if command -v rc-service >/dev/null 2>&1 && [ -f /etc/init.d/alpine-recorder ]; then
        rc-service alpine-recorder status || true
    fi
    if pgrep -fa "Xorg.*:0" >/dev/null 2>&1; then
        log_ok "Xorg server is running: $(pgrep -fa 'Xorg.*:0' | head -n 1)"
    else
        log_warn "Xorg server is not running."
    fi
    if pgrep -fa "python3 -m app.main" >/dev/null 2>&1; then
        log_ok "Recorder UI is running: $(pgrep -fa 'python3 -m app.main' | head -n 1)"
    else
        log_warn "Recorder UI is not running."
    fi
    print_recent_logs
}

do_recover() {
    log_info "Running emergency console recovery..."
    if command -v rc-service >/dev/null 2>&1 && [ -f /etc/init.d/alpine-recorder ]; then
        rc-service alpine-recorder stop 2>/dev/null || true
    fi
    pkill -f "alpine-recorder daemon" 2>/dev/null || true
    pkill -f "python3 -m app.main" 2>/dev/null || true
    pkill -x Xorg 2>/dev/null || true
    cleanup_stale_x_locks
    cleanup_legacy_boot_hooks || true
    command -v chvt >/dev/null 2>&1 && chvt 1 2>/dev/null || true
    log_ok "Stopped kiosk processes, cleaned tty1 login configuration, and switched to tty1."
}

cmd="${1:-run}"
[ $# -gt 0 ] && shift

case "$cmd" in
    run|app)
        run_foreground "$@"
        ;;
    daemon)
        run_daemon "$@"
        ;;
    start)
        if command -v rc-service >/dev/null 2>&1 && [ -f /etc/init.d/alpine-recorder ]; then
            rc-service alpine-recorder start
        else
            run_foreground "$@"
        fi
        ;;
    stop)
        if command -v rc-service >/dev/null 2>&1 && [ -f /etc/init.d/alpine-recorder ]; then
            rc-service alpine-recorder stop
        fi
        pkill -f "alpine-recorder daemon" 2>/dev/null || true
        pkill -f "python3 -m app.main" 2>/dev/null || true
        pkill -x Xorg 2>/dev/null || true
        cleanup_stale_x_locks
        command -v chvt >/dev/null 2>&1 && chvt 1 2>/dev/null || true
        log_ok "Alpine Recording Station stopped."
        ;;
    restart)
        "$0" stop
        sleep 1
        "$0" start
        ;;
    status)
        show_status
        ;;
    enable)
        if command -v rc-update >/dev/null 2>&1; then
            rc-update add alpine-recorder default
            log_ok "Enabled alpine-recorder post-boot service in 'default' runlevel."
        else
            log_err "rc-update not found."
            exit 1
        fi
        ;;
    disable)
        if command -v rc-update >/dev/null 2>&1; then
            rc-update del alpine-recorder default 2>/dev/null || true
            log_ok "Disabled alpine-recorder automatic boot service."
        else
            log_err "rc-update not found."
            exit 1
        fi
        ;;
    logs)
        print_recent_logs
        ;;
    doctor|diagnose)
        run_doctor
        ;;
    fix-packages|restore-packages)
        ensure_runtime_packages
        ;;
    recover)
        do_recover
        ;;
    --help|-h|help)
        echo "Usage: alpine-recorder <command> [options]"
        echo ""
        echo "Commands:"
        echo "  run [--vt N]     Launch X11 & recorder UI in the foreground with console error output"
        echo "  start            Start the background OpenRC kiosk service on vt${DEFAULT_VT}"
        echo "  stop             Stop the kiosk service and return to tty1 console"
        echo "  restart          Restart the kiosk service"
        echo "  status           Show service status, running processes, and recent log output"
        echo "  enable           Enable automatic post-boot startup via OpenRC"
        echo "  disable          Disable automatic post-boot startup (manual mode for troubleshooting)"
        echo "  logs             Show recent application and Xorg log output"
        echo "  doctor           Run system, X11, PyQt6, ALSA, and /storage diagnostics"
        echo "  fix-packages     Restore and cache missing X11/PyQt6 packages across diskless reboots"
        echo "  recover          Emergency recovery: stop Xorg, restore tty1 login, switch to tty1"
        ;;
    *)
        # Pass through flags like --windowed or --simulate-audio to run_foreground
        run_foreground "$cmd" "$@"
        ;;
esac
